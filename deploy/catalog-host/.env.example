# Copy to .env beside this file. Nothing here has a default worth shipping.
#
# The read-only Garage key belongs here, not the read-write one: this host
# serves bytes and writes none.
#
# Credentials only. Which catalog is served, and its bucket, are in
# config.toml beside this file.

STRATA_DB_PASSWORD=
STRATA_BLOB_SECRET=

STRATA_S3_ACCESS_KEY=
STRATA_S3_SECRET_KEY=

# Optional. Where the blob server's image takes strata-contracts and
# strata-common from, when not from GitHub: a mirror, as a base URL the
# repositories sit under. Read at build time.
# STRATA_GIT=http://git.example.lan:3000/you
# STRATA_REF=main
